# ==========================================================
# ThaiBann - Vercel Environment Variables
# Copy & Paste this content directly into Vercel Environment Variables
# ==========================================================

# 1. Database Connection (Replace with your Supabase or Neon Connection String)
DATABASE_URL=postgresql://postgres.xxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
PGSSL=true

# 2. Session & Security
JWT_SECRET=supersecretjwtkeyatleast32charslongforthethaibannapp

# 3. Application URL (Replace with your Vercel Project URL after deploy)
NEXT_PUBLIC_APP_URL=https://thaibaaapp.vercel.app

# 4. LINE Configuration (Fill in from LINE Developers Console)
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
